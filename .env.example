# Template only — no real values belong in this file.
# Copy to .env.local for local testing with `pnpm dev`.
# In production these live in the Vercel dashboard (Settings → Environment Variables).
# Changing one there requires a redeploy before it takes effect.

# Where quote requests are emailed.
NOTIFY_EMAIL=you@example.com

# Resend (https://resend.com) API key. Shown only once at creation —
# the truncated value in Resend's key table is NOT the key.
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend,
# e.g. "Nice Stitch Quotes <quotes@nicestitchla.com>".
# Before a domain is verified, use Resend's sandbox sender: onboarding@resend.dev
# (sandbox only delivers to the Resend account's own email address).
FROM_EMAIL=

# The site and the API are same-origin, so this isn't load-bearing — it just
# stops other sites pointing a browser form at the endpoint.
ALLOWED_ORIGIN=https://www.nicestitchla.com

# Optional: max combined artwork upload in bytes, checked on the server
# (default 4MB). Vercel rejects any request over 4.5MB before the quote
# function runs, so a higher value has no effect there. The form's own check
# and its "up to 4MB" wording are fixed in src/lib/quote.ts, not set here.
MAX_UPLOAD_BYTES=4194304
